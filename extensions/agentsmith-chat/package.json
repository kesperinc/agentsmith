{
  "name": "agentsmith-chat",
  "displayName": "Agent Smith Intelligent Coding Agent",
  "description": "Agent Smith Vibe Coding Orchestrator, Antigravity 3-Panel Chat, Artifacts Viewer, and Live Multi-File Diff Extension",
  "version": "1.0.0",
  "publisher": "kesperinc",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentsmith.openEditorPanel",
        "title": "Agent Smith: Open Studio in Editor",
        "category": "Agent Smith"
      },
      {
        "command": "agentsmith.openChat",
        "title": "Agent Smith: Open Studio",
        "category": "Agent Smith"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
