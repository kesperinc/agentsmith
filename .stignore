# Agent Smith Workspace Syncthing Ignore Rules (.stignore)
# UTF-8 BOM-less Encoding

# ==========================================
# 1. OS & Syncthing Metadata Files
# ==========================================
(?d).DS_Store
(?d)Desktop.ini
(?d)thumbs.db
(?d)ehthumbs.db
(?d).stversions
(?d).syncthing.*.tmp

# ==========================================
# 2. Developer Binaries & Installer Tools
# ==========================================
vs_BuildTools.exe
*.exe
*.dll
*.so
*.dylib
*.node
*.lib
*.a
*.pdb
*.obj
*.o
*.msi
*.dmg
*.iso

# ==========================================
# 3. Dependencies & Virtual Environments
# ==========================================
node_modules/
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo

# ==========================================
# 4. Build Outputs & Release Artifacts
# ==========================================
out/
dist/
build/
.cache/
.turbo/
coverage/
*.zip
*.tar.gz
*.tgz
*.7z

# VSCode Client Build & Temporary Artifacts
vscode/.build/
vscode/out/
vscode/out-build/
vscode/node_modules/
vscode/cli/target/
vscode/cli/openssl/
vscode/extensions/**/dist/
vscode/extensions/**/out/
vscode/.vscode-test/

# Backup & Temporary Folders
_backup_untracked*/

# ==========================================
# 5. Environment Secrets & Logs
# ==========================================
.env
.env.local
*.key
*.log

# Agent Smith Local Persistence Database
# Only allow configuration file, ignore local qdrant database storage
!.agentsmith/mem0_config.json
.agentsmith/
