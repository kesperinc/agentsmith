// Syncthing Ignore Rules for agentsmith workspace
// UTF-8 BOM-less | Updated: 2026-08-20

// ==========================================
// 1. OS & Syncthing Metadata Files
// ==========================================
(?d).DS_Store
(?d)Desktop.ini
(?d)thumbs.db
(?d)ehthumbs.db
(?d).stversions
(?d).syncthing.*.tmp

// ==========================================
// 2. Developer Binaries & Installer Tools
// (대용량 바이너리 - 동기화 제외)
// ==========================================
vs_BuildTools.exe
*.exe
*.dll
*.so
*.dylib
*.node
*.lib
*.a
*.pdb
*.obj
*.o
*.msi
*.dmg
*.iso

// ==========================================
// 3. Dependencies & Virtual Environments
// (패키지 매니저로 복원 가능 - 제외)
// ==========================================
node_modules/
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo

// ==========================================
// 4. Build Outputs & Release Artifacts
// (빌드 산출물 - 재빌드 가능하므로 제외)
// ==========================================
dist/
build/
.cache/
.turbo/
coverage/
*.zip
*.tar.gz
*.tgz
*.7z

// ==========================================
// 5. VSCode Client Build Artifacts
// (대용량 컴파일 결과물 - 제외)
// ==========================================
VSCode-win32-x64/
vscode/.build/
vscode/out/
vscode/out-vscode/
vscode/out-build/
vscode/node_modules/
vscode/cli/target/
vscode/cli/openssl/
vscode/extensions/**/dist/
vscode/extensions/**/out/
vscode/.vscode-test/

// ==========================================
// 6. Backup & Temporary Folders
// ==========================================
_backup_untracked*/

// ==========================================
// 7. Environment Secrets & Logs
// ==========================================
.env
.env.local
*.key
*.log

// ==========================================
// 8. Agent Smith Local Persistence DB
// (mem0_config.json 설정 파일만 동기화)
// ==========================================
.agentsmith/local.db
.agentsmith/qdrant_storage/
