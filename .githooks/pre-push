#!/bin/sh
# ============================================================
# Agent Smith Branch Guardrail - pre-push hook
# Only blocks force-push to main and staging.
# Normal push (including merge commits) is always allowed.
# Direct commits are already blocked by commit-msg hook.
# ============================================================

# Read push options from git push arguments via GIT_PUSH_OPTION_*
# Check if --force or -f flag is being used
for arg in "$@"; do
  if [ "$arg" = "--force" ] || [ "$arg" = "-f" ]; then
    CURRENT=$(git symbolic-ref --short HEAD 2>/dev/null)
    if [ "$CURRENT" = "main" ] || [ "$CURRENT" = "staging" ]; then
      echo ""
      echo "[GUARDRAIL] Force-push to '$CURRENT' is not allowed."
      echo "  Use --force-with-lease on feature/* branches only."
      echo ""
      exit 1
    fi
  fi
done

exit 0
