{
  "name": "agentsmith-chat",
  "displayName": "Agent Smith AI Studio",
  "description": "Enterprise Coding Agent Center Studio & Vibe Coding Orchestrator for Agent Smith IDE",
  "version": "1.0.0",
  "publisher": "kesperinc",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentsmith.openEditorPanel",
        "title": "Agent Smith: Open Studio (중앙 에디터)",
        "category": "Agent Smith",
        "icon": "$(sparkle)"
      },
      {
        "command": "agentsmith.openChat",
        "title": "Agent Smith: Open Studio",
        "category": "Agent Smith"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agentsmith.openEditorPanel",
          "group": "navigation",
          "when": "!resource"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentsmith.openEditorPanel",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ]
  }
}
