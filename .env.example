# =================================================================
# Agent Smith Enterprise Desktop IDE Environment Configuration
# =================================================================

# 1. Project & Workspace Root Path (Standalone Configuration)
# When agentsmith folder is moved to c:\dev\antigravity-workspace\agentsmith,
# specify the path below or leave it blank for auto-detection.
AGENTSMITH_WORKSPACE_ROOT=c:\dev\antigravity-workspace\agentsmith
AGENTSMITH_DATA_DIR=

# 2. Backend Orchestrator Server Configuration
HOST=127.0.0.1
PORT=5000
AGENTSMITH_BACKEND_HOST=127.0.0.1
AGENTSMITH_BACKEND_PORT=5000
AGENTSMITH_MCP_PORT=3000
AGENTSMITH_ENV=development

# 3. Encoding & Python Environment Guardrails
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
SpectreMitigation=false

# 4. AI Provider API Keys (Fill in your keys)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 5. On-Premise Red Hat OpenShift AI (RHOAI) vLLM Configuration
RHOAI_VLLM_ENDPOINT_URL=http://qwen-coder.rhoai.svc:8000/v1

# 6. Enterprise Authentication & Security (Optional)
ENTERPRISE_AUTH_ENABLED=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
